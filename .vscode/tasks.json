// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "npm",
            "script": "compile",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "group": "build"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "type": "npm",
            "script": "watch",
            "problemMatcher": {
                "owner": "webpack",
                "fileLocation": ["relative", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^(ERROR|WARNING) in (.*)$",
                    "severity": 1,
                    "message": 2
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "\\[webpack-cli\\] Compiler starting\\.\\.\\.",
                    "endsPattern": "webpack .* compiled successfully"
                }
            },
            "isBackground": true,
            "presentation": {
                "reveal": "never",
                "group": "watchers"
            }
        },
        {
            "type": "npm",
            "script": "watch-tests",
            "problemMatcher": "$tsc-watch",
            "isBackground": true,
            "presentation": {
                "reveal": "never",
                "group": "watchers"
            },
            "group": "build"
        },
        {
            "label": "tasks: watch-tests",
            "dependsOn": ["npm: watch", "npm: watch-tests"],
            "problemMatcher": []
        }
    ]
}
